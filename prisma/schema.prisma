generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  ANALYST
}

enum ConversationStatus {
  ACTIVE
  WAITING_ANALYST
  IN_PROGRESS
  CLOSED
}

enum ConversationMode {
  AGENT
  ANALYST
}

enum MessageRole {
  USER
  ASSISTANT
  ANALYST
  SYSTEM
}

enum TicketType {
  INC
  REQ
}

enum TicketCategory {
  ACESSO
  REDE_VPN
  HARDWARE
  SOFTWARE
  EMAIL
  OUTROS
}

enum TicketPriority {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ANALYST
  APPROVED
  RESOLVED
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  assignedChats Conversation[] @relation("AssignedAnalyst")
  tickets       Ticket[]
}

model Conversation {
  id           String             @id @default(cuid())
  status       ConversationStatus @default(ACTIVE)
  mode         ConversationMode   @default(AGENT)
  messageCount Int                @default(0)
  summary      String?

  employeeId String
  analystId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  employee User  @relation(fields: [employeeId], references: [id])
  analyst  User? @relation("AssignedAnalyst", fields: [analystId], references: [id])

  messages Message[]

  @@index([employeeId])
  @@index([status])
}

model Message {
  id             String      @id @default(cuid())
  content        String      @db.Text
  role           MessageRole
  conversationId String
  metadata       Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Ticket {
  id            String         @id @default(cuid())
  number        String         @unique
  title         String
  description   String         @db.Text
  type          TicketType
  category      TicketCategory
  priority      TicketPriority
  status        TicketStatus   @default(OPEN)
  affectedUsers Int            @default(1)
  resolution    String?        @db.Text

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([ownerId])
  @@index([status])
}

model HelpArticle {
  id      String   @id @default(cuid())
  title   String
  content String   @db.Text
  tags    String[]

  createdAt DateTime @default(now())
}
